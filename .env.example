# Application
NODE_ENV="" # Node/Express ecosystem convention is to set it to `production` when deploying the application.
ENVIRONMENT="development"
PORT="3000"
DEBUG="" # Set to `true`, `1`, or `yes` to enable debug output (e.g. table listing)
# Git commit SHA (set at build/deploy time for release tracking)
GIT_COMMIT=""
# Pino log level (trace, debug, info, warn, error, fatal). Defaults to `info`.
LOG_LEVEL="debug"
# Comma-separated list of trusted proxy CIDRs or named tokens (loopback, linklocal, uniquelocal)
# Defaults to "loopback,linklocal,uniquelocal" if not set
TRUST_PROXY=""
# Comma-separated allowed CORS origins (strings and /regex/ patterns)
# Example: https://app.example.com,/^https:\/\/.*\.preview\.example\.com$/
# Defaults to allowing all origins when not set
CORS_ORIGINS=""
# URL path prefix prepended to pagination `_links` (e.g. "/pubnet", "/testnet").
# In production, Kubernetes sets this per deployment. Locally, set it to match
# the network you're working with.
PATH_PREFIX=""

# Optional HMAC-SHA256 key for signing pagination cursors. When set, the server
# only accepts cursors it issued; must be at least 32 bytes or startup fails.
# Changing it invalidates outstanding cursors. Leave empty for unsigned cursors.
# Generate one (32 random bytes, base64url-encoded, 43 characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CURSOR_SIGNING_KEY=""

# Stellar network
NETWORK_PASSPHRASE=""
HORIZON_URL=""
RPC_URL=""

# Database: Direct connection (Mode A/C)
# The app appends a per-connection `statement_timeout` to whichever connection
# URL it uses (via the `options` parameter); any existing query string is kept.
DATABASE_URL=""

# Database: Cloud SQL Connector with IAM (Mode B)
DB_NAME=""
POSTGRES_CONNECTION_NAME=""
POSTGRES_IAM_USER=""
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_CLOUD_SQL_IP_TYPE=""

# Sentry error monitoring (optional - leave empty to disable)
SENTRY_DSN=""
