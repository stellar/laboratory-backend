#!/usr/bin/env sh
# Audit dependencies for known vulnerabilities before pushing.
# Mirrors the "Audit dependencies (OSV-Scanner)" step in .github/workflows/test.yml
# so problems are caught locally instead of failing CI.

LOCKFILE="pnpm-lock.yaml"

echo "Running OSV-Scanner on $LOCKFILE ..."

if command -v osv-scanner >/dev/null 2>&1; then
  osv-scanner scan --lockfile="$LOCKFILE"
  status=$?
elif command -v docker >/dev/null 2>&1; then
  docker run --rm -v "$(pwd):/src" -w /src \
    ghcr.io/google/osv-scanner:latest \
    scan --lockfile="/src/$LOCKFILE"
  status=$?
else
  echo "OSV-Scanner not found (install osv-scanner or Docker). Skipping scan." >&2
  exit 0
fi

if [ "$status" -ne 0 ]; then
  echo "OSV-Scanner found vulnerabilities. Fix them before pushing." >&2
  echo "To bypass (not recommended): git push --no-verify" >&2
  exit "$status"
fi

exit 0
